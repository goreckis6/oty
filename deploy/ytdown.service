[Unit]
Description=YTDown YouTube downloader
After=network.target

[Service]
Type=simple
User=ytdown
Group=ytdown
WorkingDirectory=/opt/ytdown
EnvironmentFile=-/etc/ytdown/env
ExecStart=/opt/ytdown/scripts/run.sh
Restart=on-failure
RestartSec=5

# Hardening (light)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
