# Copy to server: /etc/ytdown/env
# sudo mkdir -p /etc/ytdown && sudo cp deploy/env.example /etc/ytdown/env

# Public domain (Caddy auto-HTTPS)
DOMAIN=yts.cool
# ACME_EMAIL=admin@example.com

# Bind address and port (local dev / start.sh)
YTDOWN_HOST=0.0.0.0
YTDOWN_PORT=3000

# Worker prefix in job IDs (w1, w2, w3…)
WORKER_ID=w1
YTDOWN_DOWNLOADS_DIR=/opt/ytdown/downloads

# YouTube — symulacja przeglądarki (domyślnie włączone w kodzie)
# YTDOWN_YOUTUBE_CLIENTS=web,web_creator,mweb,tv_embedded,android
# YTDOWN_SLEEP_INTERVAL_REQUESTS=1
# YTDOWN_USER_AGENT=Mozilla/5.0 ...

# Cookies z zalogowanej sesji YouTube (zalecane na serwerze / Docker)
# Eksport: rozszerzenie „Get cookies.txt LOCALLY” → zapisz jako cookies.txt
# YTDOWN_COOKIES_FILE=/etc/ytdown/cookies.txt
# YTDOWN_COOKIES_BROWSER=chrome   # tylko lokalny dev (nie działa w kontenerze)

# Optional: override ffmpeg path (default: /usr/bin/ffmpeg)
# YTDOWN_FFMPEG_DIR=/usr/bin
